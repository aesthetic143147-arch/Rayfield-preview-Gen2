# Copy this file to .env and fill it in. Never share .env or commit it.

# Your bot's token: Developer Portal -> your app -> Bot -> Reset Token.
# The bot needs Manage Webhooks and Read Message History in the chat channels, and the
# Message Content intent turned on.
DISCORD_TOKEN=

# Which Discord channels the chat can use, as name:channelId pairs. The first is the default.
# Scripts pick one with CreateChat({ channel = "general" }).
CHANNELS=general:123456789012345678

# Port the relay listens on.
PORT=8787

# Optional. Scripts send it as X-Chat-Key. It keeps random web traffic off the relay; it is NOT
# a secret, since anyone can read it out of your script.
CHAT_KEY=

# Let players share Discord invite links (true/false).
ALLOW_INVITES=true

# Longest message a player can send.
MAX_LENGTH=300

# Optional nameplate badges: robloxId:Badge pairs, e.g. 12345:Developer,67890:Staff
BADGES=

# Custom nameplate images and GIFs players can set. off turns them off.
MEDIA=on
# Where those images may come from (comma separated). Leave empty for the default list:
# Discord, Imgur, Tenor, Giphy, GitHub raw and Roblox's CDN.
MEDIA_HOSTS=
